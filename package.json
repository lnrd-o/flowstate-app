{
  "name": "flowstate",
  "productName": "FlowState",
  "version": "0.1.0",
  "description": "FlowState - a desktop GUI for Claude Code and Antigravity CLIs",
  "main": "src/main/main.js",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "e2e": "node tests/e2e/smoke.mjs",
    "e2e:method": "node tests/e2e/methodology.mjs",
    "vendor": "node scripts/vendor.js",
    "icon": "node scripts/make-icon.mjs",
    "dist": "electron-builder --win --x64",
    "dist:dir": "electron-builder --win --x64 --dir",
    "spike:claude": "node spikes/capture.js claude",
    "spike:agy": "node spikes/capture.js agy"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.18",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.2.1"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18"
  }
}
