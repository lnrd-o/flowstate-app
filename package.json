{
  "name": "flowstate",
  "productName": "FlowState",
  "version": "0.1.6",
  "description": "FlowState - a desktop GUI for Claude Code and Antigravity CLIs",
  "author": {
    "name": "FlowState contributors",
    "email": "flowstate@users.noreply.github.com"
  },
  "homepage": "https://github.com/lnrd-o/flowstate-app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lnrd-o/flowstate-app.git"
  },
  "bugs": {
    "url": "https://github.com/lnrd-o/flowstate-app/issues"
  },
  "desktopName": "flowstate.desktop",
  "main": "src/main/main.js",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "test:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./tests/reporters/github.mjs --test-reporter-destination=stdout \"tests/unit/**/*.test.js\"",
    "e2e": "node tests/e2e/smoke.mjs",
    "e2e:method": "node tests/e2e/methodology.mjs",
    "e2e:p7": "node tests/e2e/phase7.mjs",
    "e2e:versions": "node tests/e2e/versions.mjs",
    "e2e:features": "node tests/e2e/features.mjs",
    "vendor": "node scripts/vendor.js",
    "icon": "node scripts/make-icon.mjs",
    "dist": "electron-builder --win --x64 --publish never",
    "dist:dir": "electron-builder --win --x64 --dir",
    "spike:claude": "node spikes/capture.js claude",
    "spike:agy": "node spikes/capture.js agy",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --x64 --publish never"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.18",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.2.1"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18"
  }
}
